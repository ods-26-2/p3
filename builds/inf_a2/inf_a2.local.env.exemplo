# Ajustes só desta placa para a build inf_a2 (P3). Copie para inf_a2.local.env (fora do Git):
#   cp inf_a2.local.env.exemplo inf_a2.local.env
# O inf_a2.sh lê este arquivo depois do inf_a2.env. Depois de mudar: ./inf_a2.sh parar && ./inf_a2.sh
# Comentários sempre em linha própria (no .env, comentário na mesma linha vira valor).

# Kafka da turma NA PLACA (listener PRIVATE). Atenção: o A2 da nuvem não lê este broker.
# KAFKA_BROKER=172.18.4.56:9093
# KAFKA_CONTAINER=kafka

# Outro CPF de teste (9 primeiros dígitos) ou outro intervalo entre as "pessoas"
# A2_QR_CPF_BASE=987654321
# A2_QR_INTERVALO_S=60

# O I6 puro, o mais rápido que der (sem o ritmo do vídeo)
# I6_TEMPO_REAL=nao
