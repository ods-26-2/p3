# ODS — build "inf_a2": I6 contínuo para o A2 da nuvem, no Kafka da nuvem (P3 / SIS-1). Vai para o Git.
# Comentários sempre em linha própria: no .env, comentário na mesma linha vira valor.
#
# Desenho (27/11/2026, pedido do usuário): o A2 (VER-2, main 72cedda) consome ods.i6.code_read do
# Kafka da nuvem e, para um QR válido, aciona a catraca da câmera (catracas.json: cam0 → catraca-01).
# Esta build deixa o I6 de pé na placa lendo, em laço e no ritmo do vídeo, um vídeo de QR gerado pelo
# P3 com um código que o A2 aceita (codigo_a2.py: AES-256 com CPF de teste e validade). A câmera real
# do P4 não funciona na placa (27/11/2026). Só o I6: o A2 não consome outra inferência.

# ---- código: commit completo (./preparar-codigo.sh) ----
# I6: main 89143c9 (HEAD em 27/11/2026), o mesmo da build inf (mesma imagem ods-i6: não reconstrói).
# Modo teste (I6_TEST_MODE): lê o vídeo de I6_TEST_CAMERAS_JSON em laço. Também lê o P4 por SHM.
I6_REF=89143c9e3cb912e3b2c7772d23867e2603706111

SRC_DIR=/opt/ods/src

# ---- Kafka ----
# Kafka da NUVEM (TRA-1), onde o A2 consome. Para usar o da placa: cp inf_a2.local.env.exemplo inf_a2.local.env
KAFKA_BROKER=34.66.235.91:9093
# Vazio: broker remoto (a subida só confere se ele responde)
KAFKA_CONTAINER=
# O container do Kafka da turma NA PLACA tem de continuar rodando (pedido do usuário, 25/11/2026)
KAFKA_LOCAL_CONTAINER=kafka

# ---- I6 contínuo (vídeo de QR em laço como a câmera da catraca) ----
# Pasta de vídeos do P3 (a mesma das builds inf e inf_a8); o vídeo é gerado pelo inf_a2.sh.
VIDEO_DIR=/var/lib/ods/videos
I6_VIDEO=a2-qr.mp4
# source_id da câmera da catraca no A2 (A2Local/LiberacaoCatraca/catracas.json)
I6_SOURCE_ID=cam0
# sim = o I6 lê o vídeo no ritmo dele (uma "pessoa" na catraca por volta); nao = o mais rápido que der
I6_TEMPO_REAL=sim
# Duração do vídeo (s): o QR aparece de 2 s a 6 s de cada volta
A2_QR_INTERVALO_S=30

# ---- código do QR (o que o A2 decifra) ----
# CPF de teste (9 primeiros dígitos; o A2 calcula o DV): 123456789 → 123.456.789-09, CPF fictício.
A2_QR_CPF_BASE=123456789
# Validade do código a partir da geração (dias). O inf_a2.sh gera de novo quando faltar menos de 1 dia.
A2_QR_VALIDADE_DIAS=30
# A chave AES (A2_AES_KEY) fica no inf_a2.secrets.env (fora do Git). Sem ele, a build usa a chave de
# teste que o próprio A2 usa sem .env ("a" × 32) e avisa.

# ---- teste (./inf_a2.sh testar) ----
# Quanto esperar por leituras novas do I6 (s): uma volta do vídeo e folga
I6_TESTE_ESPERA_S=90
# Atraso máximo captura → publicação (s): o A2 descarta leitura pendente com mais de 2 s (max_pending_age)
I6_TESTE_IDADE_MAX_S=2
