# ODS — build do A6 · Libras / acessibilidade (APL-2). Vai para o Git.
# Comentários sempre em linha própria: no .env, comentário na mesma linha vira valor.

# ---- código: commit completo de cada repositório (./preparar-codigo.sh) ----
# A6 e I4: branch main em 13/11/2026. O repositório s6 está vazio: o S6 do INV-2
# está dentro do repositório i4 (s6_synthesis/), e é dele que esta build constrói o S6.
A6_REF=7f47b39b087eedd981bcd8543ba94fc5f739a5aa
I4_REF=61b39a1bf6e06ae1c6d6f211f93e827ea655a633

# Validador de contrato do B4 (TRA-2), usado pelo teste de aceitação
B4_REF=bb2ea8cc34c8591de1607138537b4a0ee77bbc86

SRC_DIR=/opt/ods/src

# ---- barramento compartilhado (Kafka da turma, listener PRIVATE) ----
KAFKA_BROKER=172.18.4.56:9093

# ---- instalação ----
JETSON_IP=172.18.4.56
# Porta do tradutor na Jetson (o A6 escuta 8080 no container; a 8080 da placa já tem dono)
A6_PORTA=8086
# Sinal que ./a6.sh amostra publica como se fosse o I4 (um dos 20 do léxico em i4/lexicon/)
I4_AMOSTRA_SINAL=Aluno
