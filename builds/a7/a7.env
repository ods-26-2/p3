# ODS — build do A7 · Restaurante / áudio e voz (VER-4). Vai para o Git.
# Comentários sempre em linha própria: no .env, comentário na mesma linha vira valor.

# ---- código: commit completo de cada repositório (./preparar-codigo.sh) ----
# A7 e I5: branch main em 13/11/2026
A7_REF=3503a26d2cc6f52f4f3f70db5244a4088c0ee5e5
I5_REF=cdb00d2726de181d9d434c2836832e3cb5c2e44e

# Validador de contrato do B4 (TRA-2), usado pelo teste de aceitação
B4_REF=bb2ea8cc34c8591de1607138537b4a0ee77bbc86

SRC_DIR=/opt/ods/src

# ---- barramento compartilhado (Kafka da turma, listener PRIVATE) ----
KAFKA_BROKER=172.18.4.56:9093

# ---- instalação ----
JETSON_IP=172.18.4.56
# Porta do A7 (terminal do balcão, painel do gestor e métricas)
A7_PORTA=8000

# ---- áudio que o I5 transcreve (./a7.sh fala) ----
# Pasta da Jetson com os áudios. O padrão é a pasta de exemplos do próprio I5.
I5_AUDIO_DIR=/opt/ods/src/i5/data
I5_AUDIO=audio4.ogg
# Origem citada no evento (o "microfone" do balcão)
I5_ORIGEM=mic_balcao_1
