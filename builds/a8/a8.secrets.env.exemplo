# Opcional: na primeira subida (sem banco), ./a8.sh cria o a8.secrets.env com senhas aleatórias.
# Para escolher as senhas, copie para a8.secrets.env e preencha antes de subir. NÃO vai para o Git.
# Depois que o banco existe, a A8_DB_PASSWORD não pode mudar (ela fica gravada no volume do MySQL).
A8_DB_PASSWORD=
A8_JWT_SECRET=
