# ODS — versões da build mínima do A8 (vai para o Git)
# Comentários sempre em linha própria: no .env, comentário na mesma linha vira valor.

# ---- código: commit de cada repositório (git rev-parse HEAD na main) ----
# Commits atuais da main em 06/11/2026; troque para atualizar.
A8_REF=66af0bac9c026c9ce96e16190214c818cbf561f0
I7_REF=a4da4b0c67c875034c1b70299f5b4108d35fcb4c
# Cadeia do plano 6c: commits da branch padrão em 11/11/2026 (S4 usa master)
P4_REF=640e19e48be5a10c1a2e927988053b47f244ddba
I1_REF=30df17801c1a92c728592c9a394d88fbef1dd50a
I2_REF=5283d60cf7480da7e80d62d6fae385bd30052525
I3_REF=ac28d374a3eb05312cc79811d5af532b58a84e77
S1_REF=a9bd01313a8bc55884ad290b97b1880768bebbde
S4_REF=be0cad9e5b29d8194a002e3e512fe0f7c2c66d96
S5_REF=77483834790e7d0d34b5b296f810fa698bdacddb
# Validador de contrato do B4 (TRA-2), usado pelo teste de aceitação
B4_REF=bb2ea8cc34c8591de1607138537b4a0ee77bbc86

# Onde ./preparar-codigo.sh clona os repositórios na Jetson
SRC_DIR=/opt/ods/src

# ---- barramento compartilhado (Guia de Uso do Kafka, TRA-1) ----
# Container "kafka" que já roda na Jetson, listener PRIVATE (anuncia 172.18.4.56:9093).
# Não use a 9092: ela anuncia localhost e falha dentro de containers.
KAFKA_BROKER=172.18.4.56:9093

# ---- instalação ----
# IP da Jetson visto pelo navegador/celular que abre o frontend
JETSON_IP=172.18.4.56
# Câmera/portão atribuído às leituras do I7
I7_SOURCE_ID=cam-entrada
# Pasta da Jetson com as imagens que o I7 vai processar
I7_IMAGENS_DIR=/var/lib/ods/i7/imagens
# De onde o I7 lê no ./a8.sh testar: "video" (quadros de VIDEO_DIR/I7_VIDEO) ou "imagens" (I7_IMAGENS_DIR)
I7_FONTE=video
# Vídeo (dentro de VIDEO_DIR) que vira entrada do I7 em ./a8.sh placas-video
I7_VIDEO=cam0.mp4
# Quadros por segundo de vídeo que o I7 processa (o I7 roda em CPU: quanto mais quadros, mais demora)
I7_QUADROS_FPS=2
# Limite de quadros (0 = o vídeo inteiro)
I7_QUADROS_MAX=0

# ---- vídeo da cadeia (P4 em modo arquivo) ----
# A pasta precisa ter cam0.mp4 (H.264, 1280x720): vira o source_id "file_cam0" das zonas
VIDEO_DIR=/var/lib/ods/videos
# Quadros por segundo do vídeo (I2 e S4 usam)
VIDEO_FPS=10
