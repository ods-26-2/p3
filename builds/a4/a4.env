# ODS — build do A4 · Esporte / arbitragem (INV-1). Vai para o Git.
# Comentários sempre em linha própria: no .env, comentário na mesma linha vira valor.

# ---- código: commit completo de cada repositório (./preparar-codigo.sh) ----
# A4 e I3: branch main em 13/11/2026
A4_REF=9d6cbd4f2f013ba3a4e83548daad0c2a42343069
I3_REF=ac28d374a3eb05312cc79811d5af532b58a84e77
# Cadeia: os mesmos commits validados na build do A8 (12/11/2026)
P4_REF=640e19e48be5a10c1a2e927988053b47f244ddba
I1_REF=30df17801c1a92c728592c9a394d88fbef1dd50a
I2_REF=5283d60cf7480da7e80d62d6fae385bd30052525
S1_REF=a9bd01313a8bc55884ad290b97b1880768bebbde
S4_REF=be0cad9e5b29d8194a002e3e512fe0f7c2c66d96
S5_REF=77483834790e7d0d34b5b296f810fa698bdacddb

# Validador de contrato do B4 (TRA-2), usado pelo teste de aceitação
B4_REF=bb2ea8cc34c8591de1607138537b4a0ee77bbc86

SRC_DIR=/opt/ods/src

# ---- barramento compartilhado (Kafka da turma, listener PRIVATE) ----
KAFKA_BROKER=172.18.4.56:9093

# ---- instalação ----
# IP que o navegador do árbitro usa. Vai para dentro da imagem do front na construção
# (NEXT_PUBLIC_API_URL): se mudar, rode ./a4.sh subir --reconstruir.
JETSON_IP=172.18.4.56
# Mecanismo pan-tilt citado nos comandos ao P7 (o P7 ainda não atende pelo Kafka)
A4_P7_SOURCE_ID=pt0

# ---- vídeo da quadra (P4 em modo arquivo, player do A4 e S4) ----
VIDEO_DIR=/var/lib/ods/videos
VIDEO_ARQUIVO=quadra.mp4
# O P4 nomeia a fonte como file_<nome do arquivo sem extensão>: tem de bater com VIDEO_ARQUIVO.
VIDEO_SOURCE_ID=file_quadra
VIDEO_FPS=30

# ---- calibração (I3, sob demanda: ./a4.sh calibrar) ----
# Correspondências imagem <-> quadra. O padrão é a do repositório do I3 (dados/pontos_quadra.csv),
# medida no vídeo de referência do INV-1. Para outro vídeo, aponte para o seu CSV.
I3_CSV=/opt/ods/src/i3/dados/pontos_quadra.csv
