# ODS — build "inf_a4": só I1, I2 e I3 (P3 / SIS-1). Vai para o Git.
# Comentários sempre em linha própria: no .env, comentário na mesma linha vira valor.

# ---- código: commit completo de cada repositório (./preparar-codigo.sh) ----
# Conferido em 25/11/2026 (git ls-remote): os três são o HEAD mais novo de cada repositório.
# I1: develop (decisão do usuário em 14/11/2026). 3b2a9cc (20/11): orquestrador FIFO por
# ods.i1.command; traz os pacotes do B5 (app-plates, app-epi, app-industry, app-sports) em
# I1/artifacts, mais novos que a main do B5 (04/11, só app-plates e app-epi).
I1_REF=3b2a9cc932d14e181a6d42cf31448ab1405a39ab
# I2: main 5283d60 (05/11)
I2_REF=5283d60cf7480da7e80d62d6fae385bd30052525
# I3: main 0a7f944 (25/11). Só documentação em relação ao c3d876e (HOW_TO_RUN.md: roteiro da
# Jetson, Kafka da nuvem e a quadra do A4 com source_id INV1); código igual. Exige --registro junto
# com --kafka (ciclo de vida do artefato da 6c)
I3_REF=0a7f94432c817801e43b417d65ff509d5e1b3d5a

SRC_DIR=/opt/ods/src

# ---- Kafka ----
# Comunicação principal: o Kafka da NUVEM (TRA-1), como as aplicações (23/11/2026).
# Para usar o Kafka da placa só nesta Jetson: cp inf_a4.local.env.exemplo inf_a4.local.env
KAFKA_BROKER=34.66.235.91:9093
# Vazio: broker remoto (a subida só confere se ele responde)
KAFKA_CONTAINER=
# O container do Kafka da turma NA PLACA tem de continuar rodando (pedido do usuário, 25/11/2026),
# mesmo sem esta build usá-lo: o inf_a4.sh confere e avisa se ele estiver parado. Nunca o para.
KAFKA_LOCAL_CONTAINER=kafka

# ---- I1 (orquestrador próprio desta build, GPU/TensorRT pelo P2) ----
# Mesma imagem do builds/i1 (ods-i1-gpu:<I1_REF>): se já existe na placa, nada é construído.
I1_BASE_IMAGE=nvcr.io/nvidia/l4t-tensorrt:r10.3.0-runtime
# Pacotes com engine pronta e pasta das engines (a mesma do builds/i1: só confere as que existem)
I1_PACOTES="app-plates/1.0.0 app-epi/1.0.0 app-industry/1.0.0 app-sports/1.2.0"
I1_ENGINES_DIR=/var/lib/ods/engines
I1_COMMAND_TOPIC=ods.i1.command
# Grupo de consumo próprio: não divide os comandos com o I1 permanente. Era ods-i1-inf-restrita até
# 26/11/2026 (renomeação da build); o I1 lê com auto.offset.reset=latest, então o grupo novo não relê
# comandos antigos do tópico.
I1_CONSUMER_GROUP=ods-i1-inf-a4
I1_DEFAULT_TTL=60
I1_CONF=0.50
# Sockets do P4 de outra build (opcional; o orquestrador também lê os vídeos de VIDEO_DIR)
I1_P4_DIR=/var/lib/ods/p4-shm

# ---- entradas ----
# Pasta ORIGINAL dos vídeos do I1 (padrão do código, DEFAULT_VIDEOS_DIR): a da SIS-2 nesta placa
# (usuário sys2). Montada SÓ PARA LEITURA no mesmo caminho dentro do container: o I1 procura nela
# <SQUAD>.mp4 quando o pedido não traz "source". Em 25/11/2026 tinha INV1, INV2, VER2, VER2_2, VER5.
I1_VIDEOS_ORIGINAL=/home/sys2/SIS-2/videos
# Vídeos do P3 (assets/ do p3, instalados por ../i1/i1.sh videos), em /videos-p3 no container, para
# as equipes que a pasta da SIS-2 não tem: pedido com "source": "/videos-p3/<SQUAD>.mp4".
VIDEO_DIR=/var/lib/ods/videos
I1_VIDEOS="VER5=cam0.mp4 VER3=epi.mp4 VER6=epi.mp4 VER1=VER1.mp4 INV1=INV1.mp4"

# ---- teste (./inf_a4.sh testar) ----
# Equipe pedida ao I1 e quantos quadros. INV1 (esporte, bola) casa com a calibração da quadra
# de vôlei do I3; no INV1.mp4 a bola aparece a partir do quadro ~120.
INF_I1_EQUIPE=INV1
INF_I1_QUADROS=150
# I2: taxa nominal das detecções (o I1 lê ~25 quadros/s)
I2_FPS=25
