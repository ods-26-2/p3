# Ajustes só desta placa para a build inf_a4 (P3). Copie para inf_a4.local.env (fora do Git):
#   cp inf_a4.local.env.exemplo inf_a4.local.env
# O inf_a4.sh lê este arquivo depois do inf_a4.env; o que estiver aqui vale no lugar dele.
# Comentários sempre em linha própria (no .env, comentário na mesma linha vira valor).

# Kafka da turma NA PLACA (listener PRIVATE), quando o da nuvem (34.66.235.91:9093) estiver fora do ar.
# Para voltar à nuvem: apague o inf_a4.local.env e rode ./inf_a4.sh parar && ./inf_a4.sh
KAFKA_BROKER=172.18.4.56:9093
KAFKA_CONTAINER=kafka
