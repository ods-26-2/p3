# ODS — versões e parâmetros da build dedicada do I1 (serviço permanente na Jetson; vai para o Git)
# Comentários sempre em linha própria: no .env, comentário na mesma linha vira valor.

# ---- código ----
# I1 na develop (decisão do usuário em 14/11/2026): atualize pelo HEAD da origin/develop.
# 3b2a9cc (20/11/2026): orquestrador FIFO (I1/run_orchestrator.py) que escuta ods.i1.command.
I1_REF=3b2a9cc932d14e181a6d42cf31448ab1405a39ab
# Validador de contrato do B4 (TRA-2), usado pelo teste de aceitação
B4_REF=bb2ea8cc34c8591de1607138537b4a0ee77bbc86

# Onde o preparar-codigo.sh clona os repositórios na Jetson
SRC_DIR=/opt/ods/src

# ---- barramento ----
# As aplicações foram para a nuvem e a Jetson roda as inferências (usuário, 23/11/2026): o I1 usa o
# Kafka da nuvem, o mesmo padrão do orquestrador. Se a turma voltar ao Kafka da placa:
# KAFKA_BROKER=172.18.4.56:9093 e KAFKA_CONTAINER=kafka.
KAFKA_BROKER=34.66.235.91:9093
# Container do broker nesta placa: vazio = broker remoto (a subida só confere se ele responde)
KAFKA_CONTAINER=
# Tópico de comandos e grupo de consumo do orquestrador
I1_COMMAND_TOPIC=ods.i1.command
I1_CONSUMER_GROUP=ods-i1-orchestrator

# ---- GPU (TensorRT via P2) ----
# Pacotes B5 que ficam com engine pronta (pasta I1/artifacts/<pacote> dentro da imagem).
# São os que o orquestrador carrega: VER5/A8 placas, VER3/A5 e VER6/A3 EPI, VER1/A1 indústria,
# INV1/A4 esporte (entrada 1280x1280: compila e roda mais devagar que os outros).
I1_PACOTES="app-plates/1.0.0 app-epi/1.0.0 app-industry/1.0.0 app-sports/1.2.0"
# Engines compiladas (a mesma pasta do A8 e do A5: as que já existem só são conferidas)
I1_ENGINES_DIR=/var/lib/ods/engines
# Base da imagem (ARG BASE_IMAGE do Dockerfile.jetson): a padrão, l4t-jetpack, deu 16,5 GB
I1_BASE_IMAGE=nvcr.io/nvidia/l4t-tensorrt:r10.3.0-runtime

# ---- orquestrador ----
# Segundos que um START vale sem HEARTBEAT (o relógio começa antes de carregar a engine)
I1_DEFAULT_TTL=60
# Confiança mínima das detecções
I1_CONF=0.50

# ---- entradas ----
# Pasta dos vídeos que o orquestrador lê quando o comando não traz "source": <SQUAD>.mp4.
VIDEO_DIR=/var/lib/ods/videos
# Vídeo de cada equipe. "./i1.sh videos" (também roda no "subir") copia os que estão em assets/ do
# p3 para VIDEO_DIR e cria o link <SQUAD>.mp4 -> vídeo. O cam0.mp4 (VER5) já está na placa (A8).
# O teste usa o mesmo mapa; equipe sem vídeo é testada com o do VER5 (só prova carga na GPU).
I1_VIDEOS="VER5=cam0.mp4 VER3=epi.mp4 VER6=epi.mp4 VER1=VER1.mp4 INV1=INV1.mp4"
# Pasta do host onde o P4 de outra build (ex.: a de inferências) deixa os sockets dos quadros
# (p4_file_shm, p4_imx519_shm…). Fica em disco, não em /tmp: a /tmp do host some no boot e o
# container do I1 não voltaria sozinho.
I1_P4_DIR=/var/lib/ods/p4-shm

# ---- teste de aceitação (./i1.sh testar) ----
# Quadros publicados por equipe no teste de carga
I1_TESTE_QUADROS=30
