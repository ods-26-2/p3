# Ajustes só desta placa para a build inf (P3). Copie para inf.local.env (fica fora do Git):
#   cp inf.local.env.exemplo inf.local.env
# O inf.sh lê este arquivo depois do inf.env; o que estiver aqui vale no lugar do inf.env.
# Comentários sempre em linha própria (no .env, comentário na mesma linha vira valor).

# Kafka da turma NA PLACA (listener PRIVATE), o mesmo do i1.local.env, enquanto o Kafka da nuvem
# (34.66.235.91:9093) está fora do ar. O I1 e esta build têm de usar o mesmo broker.
KAFKA_BROKER=172.18.4.56:9093
KAFKA_CONTAINER=kafka
