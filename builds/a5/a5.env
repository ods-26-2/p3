# ODS — build do A5 · EPI / segurança (VER-3). Vai para o Git.
# Comentários sempre em linha própria: no .env, comentário na mesma linha vira valor.

# ---- código: commit completo de cada repositório (./preparar-codigo.sh) ----
# A5, S3 e I9: branch main em 13/11/2026
A5_REF=c634433915c4b032e58055a55f4699cbe6e492dc
S3_REF=d45bbfa3508ef6a21009f09ca233be2826cc19fa
I9_REF=8ae3933a3d3fa840a3ddfce0a3b8972d3ca0c59f
# Cadeia: os mesmos commits validados na build do A8 (12/11/2026)
P4_REF=640e19e48be5a10c1a2e927988053b47f244ddba
I1_REF=30df17801c1a92c728592c9a394d88fbef1dd50a
I2_REF=5283d60cf7480da7e80d62d6fae385bd30052525
S1_REF=a9bd01313a8bc55884ad290b97b1880768bebbde
S4_REF=be0cad9e5b29d8194a002e3e512fe0f7c2c66d96

# Validador de contrato do B4 (TRA-2), usado pelo teste de aceitação
B4_REF=bb2ea8cc34c8591de1607138537b4a0ee77bbc86

SRC_DIR=/opt/ods/src

# ---- barramento compartilhado (Kafka da turma, listener PRIVATE) ----
KAFKA_BROKER=172.18.4.56:9093

# ---- instalação ----
JETSON_IP=172.18.4.56
# development cria os usuários de teste (operador/operador123…); production exige A5_ADMIN_SENHA
A5_ENV=production
A5_EXIGIR_LOGIN=true

# ---- vídeo da cadeia (P4 em modo arquivo) ----
# A pasta precisa ter cam0.mp4 (H.264, 1280x720): vira o source_id "file_cam0" das zonas
VIDEO_DIR=/var/lib/ods/videos
VIDEO_FPS=10

# ---- modelo do I1 ----
# Pasta da Jetson montada em /modelos no I1. Sem modelo de EPI publicado pelo B5/MOD-1,
# o padrão é o modelo de placas que vem dentro do I1 (só prova o transporte até o I9).
MODELOS_DIR=/var/lib/ods/modelos
I1_ONNX=/app/I1/artifacts/app-plates/1.0.0/app-plates.onnx
I1_METADATA=/app/I1/artifacts/app-plates/1.0.0/metadata.json
