# ODS — build do A5 · EPI / segurança (VER-3). Vai para o Git.
# Comentários sempre em linha própria: no .env, comentário na mesma linha vira valor.

# ---- código: commit completo de cada repositório (./preparar-codigo.sh) ----
# A5 e I9: branch main (sem commits novos desde 05/11 e 31/10; conferido em 17/11/2026)
A5_REF=c634433915c4b032e58055a55f4699cbe6e492dc
I9_REF=8ae3933a3d3fa840a3ddfce0a3b8972d3ca0c59f
# S3: branch main em 17/11/2026 (1a322c4 só muda documentação e o instalador do servidor)
S3_REF=1a322c4b72b1a478fb4f6e39edff4b4727235255
# Cadeia: os mesmos commits da build do A8, validados na Jetson (12 e 14/11/2026)
P4_REF=640e19e48be5a10c1a2e927988053b47f244ddba
# I1: develop (decisão do usuário, 14/11/2026), a mesma imagem GPU do A8 (ods-i1-gpu:<ref>)
# 23/11/2026: 3b2a9cc (orquestrador novo; run_detector, pipeline e Dockerfile.jetson iguais ao cb5c381
# validado no A8). Mesma imagem da build dedicada builds/i1. Ainda não testado nesta build.
I1_REF=3b2a9cc932d14e181a6d42cf31448ab1405a39ab
I2_REF=5283d60cf7480da7e80d62d6fae385bd30052525
S1_REF=a9bd01313a8bc55884ad290b97b1880768bebbde
S4_REF=be0cad9e5b29d8194a002e3e512fe0f7c2c66d96

# Validador de contrato do B4 (TRA-2), usado pelo teste de aceitação
B4_REF=bb2ea8cc34c8591de1607138537b4a0ee77bbc86

SRC_DIR=/opt/ods/src

# ---- barramento compartilhado (Kafka da turma, listener PRIVATE) ----
KAFKA_BROKER=172.18.4.56:9093

# ---- instalação ----
JETSON_IP=172.18.4.56
# development cria os usuários de teste (operador/operador123…); production exige A5_ADMIN_SENHA
A5_ENV=production
A5_EXIGIR_LOGIN=true

# ---- vídeo da cadeia (P4 em modo arquivo; S4 lê o mesmo arquivo) ----
# Vídeo com pessoas usando (ou não) capacete e colete, H.264, 1920x1080: a zona de exemplo
# (artefatos/zones-a5-p3-2.json) cobre o quadro inteiro em 1920x1080, a resolução do epi.mp4 da
# placa (conferida em 18/11/2026). Vídeo de outra resolução pede outra zona: veja o C13 do teste.
# O P4 publica com source_id "file_<nome sem .mp4>": epi.mp4 -> file_epi, que é o source_id das
# zonas e do teste de aceitação.
VIDEO_DIR=/var/lib/ods/videos
VIDEO_ARQUIVO=epi.mp4
VIDEO_SOURCE_ID=file_epi
VIDEO_FPS=10

# ---- I1 na GPU (TensorRT via P2), como no A8 ----
# Pacote B5 que vem dentro do I1 (develop): app-epi 1.0.0, classes pessoa/capacete/colete
# (mAP@0,5 = 0,95; publicado pelo B5/MOD-1 em 20/10/2026). O I9 usa exatamente essas classes.
I1_PACOTE=app-epi/1.0.0
# Engines TensorRT compiladas na placa (compartilhada com o A8: uma pasta por pacote)
I1_ENGINES_DIR=/var/lib/ods/engines
# Base da imagem do I1: a l4t-tensorrt runtime (4,5 GB), não a l4t-jetpack (16,5 GB). Ver A8.
I1_BASE_IMAGE=nvcr.io/nvidia/l4t-tensorrt:r10.3.0-runtime
