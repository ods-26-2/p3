# ODS — build "inf_a8": I7 contínuo para o A8, no Kafka da nuvem (P3 / SIS-1). Vai para o Git.
# Comentários sempre em linha própria: no .env, comentário na mesma linha vira valor.
#
# Desenho (27/11/2026, pedido do usuário): o A8 roda na nuvem (VER-5, develop f50b5a4) e consome só
# ods.i7.plate_read. Esta build deixa o I7 de pé na placa, lendo o cam0.mp4 (VER-5) em laço como se
# fosse a câmera da entrada, e publicando no Kafka da nuvem. O I1 (placas, VER5) é o da inf_a4, sob demanda
# (./inf_a8.sh i1): o A8 não consome detecções, e uma sessão contínua do VER5 seguraria o
# orquestrador (um modelo por vez) e deixaria o A4 sem I1.

# ---- código: commit completo (./preparar-codigo.sh) ----
# I7: branch development 9e24056 (26/11/2026; regra do usuário, 27/11: vale a branch com o código mais
# apto, não a main). Contém tudo da main 1441bbb (o único commit da main fora dela é o merge, sem
# conteúdo) e acrescenta: validação do contrato antes de publicar (evento inválido não sai),
# SALVAR_MOSAICOS (só mosaicos de leituras publicadas), leitura ao vivo por http/rtsp e o Kafka da
# nuvem como padrão. Interface usada pelo P3 igual (--video, VideoCapture, validar_evento).
# Imagem do P3 ods-i7-gpu (receita no compose); trocar o commit = construir de novo na placa.
# Voltar à main: I7_REF=1441bbb5b0bfc5a2bd842e91c82ff8ab3626d4f9
I7_REF=9e2405693bdffab6d0c34f920065d06c9151f582

SRC_DIR=/opt/ods/src

# ---- Kafka ----
# Kafka da NUVEM (TRA-1), onde o A8 consome. Para usar o da placa: cp inf_a8.local.env.exemplo inf_a8.local.env
KAFKA_BROKER=34.66.235.91:9093
# Vazio: broker remoto (a subida só confere se ele responde)
KAFKA_CONTAINER=
# O container do Kafka da turma NA PLACA tem de continuar rodando (pedido do usuário, 25/11/2026):
# o inf_a8.sh confere e avisa se ele estiver parado. Nunca o para.
KAFKA_LOCAL_CONTAINER=kafka

# ---- I7 contínuo (vídeo em laço como câmera) ----
# Vídeo do estacionamento da VER-5 (cam0.mp4, placas brasileiras), na pasta de vídeos do P3
# (VIDEO_DIR das outras builds; instalado em 14/11/2026). Montada só para leitura, sem criar a pasta.
# NÃO use o VER5.mp4 da SIS-2 (/home/sys2/SIS-2/videos) no I7: as placas dele não são brasileiras
# (ex.: 34A36837) e o I7 as descarta todas como "Inválida" (Jetson, 27/11/2026). Ele serve ao I1
# (./inf_a8.sh i1). A câmera real do P4 não funciona na placa (27/11/2026).
I7_VIDEO_DIR=/var/lib/ods/videos
I7_VIDEO=cam0.mp4
# source_id das leituras: o A8 só aciona a cancela de "cam-entrada" ou "cam-saida"
# (backend/src/cancela/index.js da develop do A8)
I7_SOURCE_ID=cam-entrada
# sim = processa o vídeo no ritmo dele (como uma câmera: o A8 vê os carros no tempo do vídeo);
# nao = o mais rápido que der (rajada de leituras a cada volta)
I7_TEMPO_REAL=sim
# Pausa entre uma volta do vídeo e a próxima (s). A cada volta as mesmas placas são publicadas de novo.
I7_PAUSA_S=30
# Quadros do vídeo processados por segundo (padrão do I7: 2)
I7_QUADROS_POR_SEGUNDO=2

# GPU do I7 (TensorRT pelo P2): a mesma base e a mesma engine do I1. O I7 só lê
# ENGINES_DIR/app-plates-1.0.0, que a inf_a4 compila (../inf_a4/inf_a4.sh engines).
TRT_BASE_IMAGE=nvcr.io/nvidia/l4t-tensorrt:r10.3.0-runtime
ENGINES_DIR=/var/lib/ods/engines

# ---- I1 sob demanda (./inf_a8.sh i1) ----
# Pedido ao orquestrador da inf_a4: equipe VER5 (pacote app-plates). Sem "source", o I1 lê
# /home/sys2/SIS-2/videos/VER5.mp4 (trânsito com placas estrangeiras: serve à detecção).
I1_COMMAND_TOPIC=ods.i1.command
INF_I1_EQUIPE=VER5
INF_I1_QUADROS=150

# ---- teste (./inf_a8.sh testar) ----
# Quanto esperar por leituras novas do I7 (s): no ritmo do vídeo, uma volta inteira mais a pausa e folga
I7_TESTE_ESPERA_S=420
# Idade máxima do captured_at na leitura (s): o A8 não abre a cancela para evento antigo
I7_TESTE_IDADE_MAX_S=120
