# Ajustes só desta placa para a build inf_a1 (P3). Copie para inf_a1.local.env (fora do Git):
#   cp inf_a1.local.env.exemplo inf_a1.local.env
# O inf_a1.sh lê este arquivo depois do inf_a1.env. Depois de mudar: ./inf_a1.sh parar && ./inf_a1.sh
# Comentários sempre em linha própria (no .env, comentário na mesma linha vira valor).

# Kafka da turma NA PLACA (listener PRIVATE). Atenção: o A1 da nuvem não lê este broker.
# KAFKA_BROKER=172.18.4.56:9093
# KAFKA_CONTAINER=kafka

# Rodadas mais espaçadas (menos carga no Kafka da turma)
# I8_INTERVALO_S=300
