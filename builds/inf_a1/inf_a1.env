# ODS — build "inf_a1": I8 contínuo para o A1 da nuvem, no Kafka da nuvem (P3 / SIS-1). Vai para o Git.
# Comentários sempre em linha própria: no .env, comentário na mesma linha vira valor.
#
# Desenho (27/11/2026, pedido do usuário): o A1 (VER-1, main 5e0f07e, implantado na GCP com o Kafka da
# nuvem) consome ods.industria.defeito_classificado 2.0 (e ainda o legado ods.i8.piece_analysis 1.0).
# O I8 não faz inferência de verdade hoje: o repositório não traz imagens nem manifesto real (docs do
# I8, sprint 3: "A prova local usa eventos sintéticos, não inferência real"). Esta build deixa de pé o
# publicador OFICIAL do I8 reenviando, em laço, os 4 eventos de exemplo dele (CONFORMING,
# NON_CONFORMING, ANOMALY, UNCERTAIN), com ids e horários novos e validados contra o contrato 2.0 e a
# taxonomia do A1 antes de publicar. São eventos SINTÉTICOS, marcados com artifact_version
# p3-exemplos-i8. O I1 (VER1, peças) é o da inf_a4, sob demanda (./inf_a1.sh i1): o A1 não consome
# detecções. O P7 (pan-tilt) que o A1 comanda não tem Kafka (SIS-2).

# ---- código: commit completo (./preparar-codigo.sh) ----
# I8: main 051851f (HEAD em 27/11/2026), o mesmo da build inf (imagem ods-i8-publisher: não reconstrói)
I8_REF=051851f8c7889aba4da8422293c911aa84579da4
# A1: só a taxonomia de defeitos (shared/artifacts/defect-taxonomy), que o publicador exige, e o
# validador do próprio A1 (backend/contracts.py) no teste. O MESMO commit das builds inf e a1 (o clone
# SRC_DIR/a1 é um só): a taxonomia, os schemas e o contracts.py são idênticos aos do HEAD 5e0f07e
# (27/11/2026, git diff vazio).
A1_REF=5d17305048f21914ed46d4fbe0770c81180215eb

SRC_DIR=/opt/ods/src

# ---- Kafka ----
# Kafka da NUVEM (TRA-1), onde o A1 consome. Para usar o da placa: cp inf_a1.local.env.exemplo inf_a1.local.env
KAFKA_BROKER=34.66.235.91:9093
# Vazio: broker remoto (a subida só confere se ele responde)
KAFKA_CONTAINER=
# O container do Kafka da turma NA PLACA tem de continuar rodando (pedido do usuário, 25/11/2026)
KAFKA_LOCAL_CONTAINER=kafka

# ---- I8 contínuo (eventos de exemplo do I8 em laço) ----
# Tópico final do A1 (contrato 2.0)
I8_TOPICO=ods.industria.defeito_classificado
I8_TAXONOMIA_VERSAO=defects-a1-1.0.0
# Intervalo entre uma rodada (4 eventos) e a próxima (s)
I8_INTERVALO_S=60

# ---- I1 sob demanda (./inf_a1.sh i1) ----
# Pedido ao orquestrador da inf_a4: equipe VER1 (pacote app-industry, classe peca). A pasta da SIS-2
# não tem o VER1.mp4: o pedido vai com "source": "/videos-p3/VER1.mp4" (vídeo do P3, 4K).
I1_COMMAND_TOPIC=ods.i1.command
INF_I1_EQUIPE=VER1
INF_I1_QUADROS=150
VIDEO_DIR=/var/lib/ods/videos

# ---- teste (./inf_a1.sh testar) ----
# Quanto esperar por eventos novos (s): uma rodada e folga
I8_TESTE_ESPERA_S=150
