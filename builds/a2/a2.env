# ODS — build do A2 · Acesso / identificação (VER-2). Vai para o Git.
# Comentários sempre em linha própria: no .env, comentário na mesma linha vira valor.

# ---- código: commit completo de cada repositório (./preparar-codigo.sh) ----
# A2 e I6: branch develop em 13/11/2026 (a main está muito atrás: sem Dockerfile, sem Kafka).
A2_REF=708b2dd182495951b34b7776492a2f95be5ae8a4
I6_REF=ff1bf44806bcbc36b73d3b7ac85b8ab8cc0533c5
# S4: branch master em 13/11/2026 (o mesmo commit da build do A8)
S4_REF=be0cad9e5b29d8194a002e3e512fe0f7c2c66d96

# Validador de contrato do B4 (TRA-2), usado pelo teste de aceitação
B4_REF=bb2ea8cc34c8591de1607138537b4a0ee77bbc86

SRC_DIR=/opt/ods/src

# ---- barramento compartilhado (Kafka da turma, listener PRIVATE) ----
KAFKA_BROKER=172.18.4.56:9093

# ---- instalação ----
JETSON_IP=172.18.4.56
# Câmera da portaria. O mesmo nome tem de estar em config/catracas.json (source_id da catraca-01).
I6_SOURCE_ID=cam-portaria
# O que o I6 lê. Arquivo dentro de VIDEO_DIR (relido em laço) ou URL de câmera IP/celular,
# ex.: http://192.168.0.50:8080/video
I6_CAMERA_URL=/videos/portaria.mp4
# true = sem catraca física: o A2 sobe o simulador do VER-2 (config/configCatraca.json)
A2_SIMULATION=true

# ---- vídeo (I6 em modo arquivo e S4) ----
VIDEO_DIR=/var/lib/ods/videos
VIDEO_ARQUIVO=portaria.mp4
VIDEO_FPS=10
