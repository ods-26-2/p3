# Ajustes só desta placa para a build inf_restrita (P3). Copie para inf_restrita.local.env (fora do Git):
#   cp inf_restrita.local.env.exemplo inf_restrita.local.env
# O inf_restrita.sh lê este arquivo depois do inf_restrita.env; o que estiver aqui vale no lugar dele.
# Comentários sempre em linha própria (no .env, comentário na mesma linha vira valor).

# Kafka da turma NA PLACA (listener PRIVATE), quando o da nuvem (34.66.235.91:9093) estiver fora do ar.
# Para voltar à nuvem: apague o inf_restrita.local.env e rode ./inf_restrita.sh parar && ./inf_restrita.sh
KAFKA_BROKER=172.18.4.56:9093
KAFKA_CONTAINER=kafka
